{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xenithium:xrv:fixture:v1",
  "title": "Xenithium Replay Validation fixture v1",
  "type": "object",
  "required": ["schema","schema_version","fixture_id","kernel","model_fingerprint","runtime_fingerprint","tp","operation","quantization","position","masks","mutable_state","tensors","reference","provenance"],
  "properties": {
    "schema": {"const":"org.xenithium.xrv.fixture"},
    "schema_version": {"const":1},
    "fixture_id": {"type":"string","minLength":1},
    "kernel": {"type":"object","required":["id","version","implementation"],"properties":{"id":{"type":"string"},"version":{"type":"integer","minimum":1},"implementation":{"type":"string"}},"additionalProperties":true},
    "model_fingerprint":{"type":"object"},"runtime_fingerprint":{"type":"object"},
    "tp":{"type":"object","required":["rank","size"],"properties":{"rank":{"type":"integer","minimum":0},"size":{"type":"integer","minimum":1}},"additionalProperties":true},
    "operation":{"type":"object","required":["rows","stride","bound","top_k"],"properties":{"rows":{"type":"integer","minimum":1},"stride":{"type":"integer","minimum":1},"bound":{"type":"integer","minimum":1},"top_k":{"type":"integer","minimum":1},"chunk":{"type":"integer","minimum":0}},"additionalProperties":true},
    "quantization":{"type":"object"},"position":{"type":"object"},"masks":{"type":"array"},"mutable_state":{"type":"array"},
    "tensors":{"type":"object","minProperties":4,"additionalProperties":{"type":"object","required":["file","dtype","shape","strides","byte_order","role","size_bytes","sha256"],"properties":{"file":{"type":"string","minLength":1},"dtype":{"type":"string"},"shape":{"type":"array","minItems":1,"items":{"type":"integer","minimum":1}},"strides":{"type":"array","minItems":1,"items":{"type":"integer","minimum":1}},"byte_order":{"const":"little"},"role":{"type":"string"},"size_bytes":{"type":"integer","minimum":0},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"additionalProperties":true}},
    "reference":{"type":"object","required":["independent","source"],"properties":{"independent":{"const":true},"source":{"type":"string"}},"additionalProperties":true},
    "provenance":{"type":"object"}
  },
  "additionalProperties":true
}
